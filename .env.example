# Configurações do servidor
PORT=3000
NODE_ENV=development
API_VERSION=v1

# Configurações do banco PostgreSQL (para conexão direta - opcional)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sidcafe
DB_USER=sidcafe
DB_PASSWORD=sidcafe123
DB_SSL=false
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=30000

# Prisma Database URL (usado pelo Prisma ORM)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://sidcafe:sidcafe123@localhost:5432/sidcafe?schema=public"

# JWT (para futuro uso)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=*