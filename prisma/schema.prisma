// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de usuário com autenticação
model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String
  password      String         // Hash bcrypt
  isActive      Boolean        @default(true) @map("is_active")
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  
  // Relacionamento com vendas
  vendasCliente Sale[]         @relation("ClienteSale")

  @@map("users")
}

// Tipos de roles/permissões
enum UserRole {
  USER
  ADMIN
  MODERATOR
}

// Tokens de refresh para autenticação
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  isRevoked Boolean  @default(false) @map("is_revoked")

  @@index([userId])
  @@map("refresh_tokens")
}

// Modelo de exemplo - Health Check
model HealthCheck {
  id        Int      @id @default(autoincrement())
  status    String   @db.VarChar(50)
  details   Json?
  checkedAt DateTime @default(now()) @map("checked_at")

  @@map("health_checks")
}

// Modelo de categoria de produtos
model Category {
  id          Int       @id @default(autoincrement())
  nome        String    @db.VarChar(100)
  descricao   String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // Relacionamento com produtos
  produtos    Product[]

  @@map("categories")
}

// Modelo de produto
model Product {
  id            Int       @id @default(autoincrement())
  nome          String    @db.VarChar(150)
  descricao     String?   @db.Text
  preco         Decimal   @db.Decimal(10, 2) // Até 99.999.999,99
  imagem        String?   @db.VarChar(500) // URL da imagem do produto
  categoriaId   Int       @map("categoria_id")
  estoqueAtual  Int       @default(0) @map("estoque_atual")
  estoqueMinimo Int       @default(0) @map("estoque_minimo") // Para alertas
  ativo         Boolean   @default(true) // Para soft delete
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Relacionamento com categoria
  categoria     Category  @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  
  // Relacionamento com vendas
  vendas        SaleItem[]

  @@index([categoriaId])
  @@index([ativo])
  @@map("products")
}

// Enum para status das vendas
enum SaleStatus {
  PENDING    // Venda criada, aguardando processamento
  CONFIRMED  // Venda confirmada
  CANCELLED  // Venda cancelada
  COMPLETED  // Venda finalizada
}

// Modelo de venda (cabeçalho)
model Sale {
  id              Int        @id @default(autoincrement())
  clienteId       Int        @map("cliente_id")
  valorTotal      Decimal    @default(0) @db.Decimal(12, 2) @map("valor_total") // Valor total da venda
  desconto        Decimal?   @default(0) @db.Decimal(10, 2) // Desconto aplicado
  valorFinal      Decimal    @default(0) @db.Decimal(12, 2) @map("valor_final") // Valor após desconto
  status          SaleStatus @default(PENDING)
  observacoes     String?    @db.Text // Observações da venda
  dataVenda       DateTime   @default(now()) @map("data_venda")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  
  // Relacionamentos
  cliente         User       @relation("ClienteSale", fields: [clienteId], references: [id], onDelete: Restrict)
  itens           SaleItem[] // Itens da venda

  @@index([clienteId])
  @@index([status])
  @@index([dataVenda])
  @@map("sales")
}

// Modelo de item de venda
model SaleItem {
  id              Int     @id @default(autoincrement())
  saleId          Int     @map("sale_id")
  produtoId       Int     @map("produto_id")
  quantidade      Int     // Quantidade vendida
  precoUnitario   Decimal @db.Decimal(10, 2) @map("preco_unitario") // Preço na hora da venda
  valorTotal      Decimal @db.Decimal(12, 2) @map("valor_total") // quantidade * precoUnitario
  createdAt       DateTime @default(now()) @map("created_at")
  
  // Relacionamentos
  venda           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  produto         Product @relation(fields: [produtoId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([produtoId])
  @@map("sale_items")
}
